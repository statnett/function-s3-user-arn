{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>statnett/renovate-config"],
  "crossplane": {
    "managerFilePatterns": [
      "/(^|/)example/.*\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "crossplane"
      ],
      "matchFileNames": [
        "example/**"
      ],
      "groupName": "examples"
    }
  ],
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ]
}
